<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d0d0d">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تسطير"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#ffffff"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="صانع الكيبورد: أبوجبل ابن الكوت"
            android:textColor="#888888"
            android:paddingBottom="14dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btn_enable"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="⚡ تفعيل الكيبورد"/>
            <Button
                android:id="@+id/btn_choose"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="✅ اختيار الكيبورد"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ سرعة الكتابة (1-500)"
            android:textColor="#ffffff"
            android:paddingTop="18dp"/>
        <TextView
            android:id="@+id/tv_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="200"
            android:textStyle="bold"
            android:textColor="#4db6ac"/>
        <SeekBar
            android:id="@+id/sb_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✂️ الفارزة"
            android:textColor="#ffffff"
            android:paddingTop="16dp"/>
        <Switch
            android:id="@+id/sw_sep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تفعيل الفارزة"
            android:textColor="#ffffff"/>
        <Spinner
            android:id="@+id/sp_sep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Switch
            android:id="@+id/sw_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="كل ضغطة حرف → كلمة"
            android:textColor="#ffffff"
            android:paddingTop="12dp"/>
        <Switch
            android:id="@+id/sw_letter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="كل ضغطة حرف → حرف عشوائي"
            android:textColor="#ffffff"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📝 الكلمات (كل كلمة بسطر)"
            android:textColor="#ffffff"
            android:paddingTop="16dp"/>
        <EditText
            android:id="@+id/et_words"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:textColor="#ffffff"
            android:textColorHint="#777777"
            android:background="#1e1e1e"
            android:padding="12dp"
            android:hint="الصق قائمتك هنا..."/>

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="💾 حفظ"/>
    </LinearLayout>
</ScrollView>
